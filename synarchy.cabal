executable synarchy
    import: warnings, lang, build-policy
    -- .hs or .lhs file containing the Main module.
    main-is: Main.hs
    other-modules: App.Boot
                 , App.Cli
                 , App.Exception
                 , App.Graphical
                 , App.Offscreen
                 , App.Headless
                 , App.Dump
                 , App.Preview
                 , App.Preview.Config
                 , App.LanguageReport
                 , App.ResourceRoot
    default-extensions: FlexibleInstances
    other-extensions: Strict
                    , StrictData
                    , TemplateHaskell
    -- Other library packages from which modules are imported.
    build-depends: base >=4.20 && <5
                 , base-unicode-symbols
                 , bytestring
                 , containers
                 , filepath
                 , directory
                 , GLFW-b
                 , hslua
                 , JuicyPixels
                 , linear
                 , monad-logger
                 , mtl
                 , network
                 , stm
                 , synarchy
                 , text
                 , time
                 , vector
                 , vector-algorithms
                 , vector-th-unbox
                 , cereal
                 , yaml
                 , aeson
                 , random
                 , deepseq
                 , parallel
                 , unordered-containers
                 , vulkan
                 , vulkan-utils
                 , template-haskell
                 , unliftio
                 , unliftio-core
                 , utf8-string
    -- Directories containing source files.
    hs-source-dirs: app
    ghc-options: -rtsopts
                 "-with-rtsopts=-N -A128M"

-- BUILD-ONLY IN AUTOMATED GATES, AND REQUIRES A REAL DISPLAY (#1153).
-- `.github/workflows/ci.yml` and `make ci` (`tools/ci-local.sh`) both
-- `cabal build` this suite and neither ever `cabal test`s it, so it is a
-- compile gate, not a running one. That is not an oversight to fix by
-- adding a test step: `test/Spec.hs` calls `GLFW.init` and creates a real
-- window, `error`ing on either failure, before `hspec` runs -- on a
-- machine with no display it yields no assertions at all. Running it by
-- hand on a graphics-capable desktop is the only way it executes.
--
-- Consequently every spec here MUST need a display. The GPU-free specs
-- moved to `synarchy-test-headless` (which every CI run does execute) in
-- #1153; do not add another one here.
test-suite synarchy-test-graphical
    import: warnings, lang, build-policy
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Spec.hs
    other-modules: Test.Engine.Graphics.Window.GLFW
                   Test.Engine.Graphics.Vulkan.Instance
                   Test.Engine.Graphics.Vulkan.Surface
                   Test.Engine.Graphics.Vulkan.Helpers
                   Test.Engine.Graphics.Vulkan.Device
    build-depends: base >=4.20 && <5
                , base-unicode-symbols
                , bytestring
                , containers
                , directory
                , filepath
                , hspec
                , hslua
                , JuicyPixels
                , synarchy
                , text
                , monad-logger
                , stm
                , mtl
                , vector
                , vector-algorithms
                , vector-th-unbox
                , cereal
                , yaml
                , aeson
                , random
                , deepseq
                , parallel
                , unordered-containers
                , GLFW-b
                , vulkan
                , vulkan-utils
    ghc-options: "-with-rtsopts=-N -A128M"
    if flag(dev) && os(darwin)
      ghc-options: -fsanitize=address

test-suite synarchy-test-headless
    import: warnings, lang, build-policy
    type: exitcode-stdio-1.0
